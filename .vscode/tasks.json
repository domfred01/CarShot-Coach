{
  "version": "2.0.0",
  "tasks": [
    {"label": "CarShot: start web preview", "type": "shell", "command": "npm.cmd", "args": ["run", "dev"], "options": {"cwd": "${workspaceFolder}/web"}, "isBackground": true, "problemMatcher": []},
